# Central Server 配置模板
# cp deployment/central-server.env.example deployment/central-server.env
# 然后修改 IP / 密码；central-server.env 已被 gitignore，勿提交。

CENTRAL_SERVER_IP=192.168.235.42
AGGREGATION_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DASHBOARD_PORT=3000

MINIO_ROOT_USER=fedscale
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=fedscale-bucket
# 数据目录：无 sudo 时用仓库内路径；有 /data 权限可改为 /data/minio
MINIO_DATA_DIR=/home/pcllgr/liuchao/fedscale-icc-server/data/minio
# 下列二进制仅作备用（正式部署用 Docker Compose）
MINIO_BIN=/home/pcllgr/liuchao/fedscale-icc-server/tools/minio/minio
MC_BIN=/home/pcllgr/liuchao/fedscale-icc-server/tools/minio/mc

MINIO_ENDPOINT=http://192.168.235.42:9000
SERVER_URL=http://192.168.235.42:8080

NUM_CLIENTS=2
NUM_ROUNDS=20
# CFG-2：真正决定每轮上传量的是 COVERAGE_H（≈ 1/H），不是 RATIO。
# RATIO 只作展示/校验；改上传比例请改 configs/s3r12v3-fsdp-run.yaml 的 coverage_h。
COVERAGE_H=5
SLOTS_PER_ROUND=1
RATIO=0.2

LOG_DIR=/home/pcllgr/liuchao/fedscale-icc-server/logs
RESULTS_DIR=/home/pcllgr/liuchao/fedscale-icc-server/results/round_logs
