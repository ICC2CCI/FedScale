# Public address of the center node hosting object-store-minio. The TLS
# certificate must include this exact IP in subjectAltName.
MINIO_DIRECT_ENDPOINT=https://81.71.45.59:30900

# Current client-node public IP allowlist, one CIDR per line. Keep this list in
# sync with `object-store-minio-direct-allowlist` before using the NodePort.
CLIENT_EGRESS_CIDRS=81.71.31.45/32,119.91.149.148/32,175.178.245.173/32,43.142.65.37/32,124.220.5.185/32,101.35.91.232/32
